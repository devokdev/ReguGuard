# ==============================================================================
# ReguGuard Environment Configuration Example
# ==============================================================================

# Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# Gemini API Key (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Configuration
GENERATOR_MODEL=llama-3.3-70b-versatile
JUDGE_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=text-embedding-004

# Service Ports & Hosts
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
A2A_SERVER_PORT=8001
BLACKBOARD_SERVER_PORT=8002

# Storage Paths
DATA_DIR=data
DB_PATH=data/reguguard.db
TRACE_DB_PATH=data/traces.db
CHROMA_DIR=data/chroma

# Execution Limits
MAX_USD_BUDGET=0.0
SEED=42
